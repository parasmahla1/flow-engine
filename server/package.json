{
  "name": "@flowengine/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc --noEmit",
    "test": "vitest run src/**/*.test.ts --environment node",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema prisma/schema.prisma"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@flowengine/shared": "1.0.0",
    "@prisma/client": "^5.16.1",
    "bullmq": "^5.8.7",
    "fastify": "^4.28.1",
    "ioredis": "^5.4.1",
    "jsonpath-plus": "^10.0.0",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "prisma": "^5.16.1",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4",
    "vitest": "^1.6.0"
  }
}
